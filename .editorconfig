# EditorConfig — https://editorconfig.org
#
# Keep editors from fighting the repository: Go is gofmt-formatted (tabs), the
# Markdown/YAML/JSON documents use 2 spaces, and every tracked text file is LF.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# gofmt owns Go formatting: indentation is tabs.
[*.go]
indent_style = tab

# Makefile recipes must be tab-indented.
[Makefile]
indent_style = tab
[*.mk]
indent_style = tab

# Shell scripts in this repository use tab indentation.
[*.sh]
indent_style = tab

# Go module files use tabs for the require/retract blocks.
[*.mod]
indent_style = tab
[go.mod]
indent_style = tab

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

# Markdown hard line breaks are two trailing spaces, so keep them.
[*.{md,markdown}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
